#!/bin/bash

# ATEM Audio Router — macOS .app launcher
# Collects settings via dialogs, then launches the server in Terminal
# to avoid macOS App Translocation and sandbox restrictions.

CONFIG_FILE="$HOME/.atem-router-config"

# ── Load saved config ────────────────────────────
ATEM_IP=""
SPLIT_STEREO=""
SERVER_DIR=""

if [ -f "$CONFIG_FILE" ]; then
    source "$CONFIG_FILE"
fi

# ── Locate the repo ─────────────────────────────
# If we don't have a saved server dir, or it no longer exists, find it
if [ -z "$SERVER_DIR" ] || [ ! -d "$SERVER_DIR" ]; then
    # Check common locations
    for CHECK_DIR in \
        "$HOME/Downloads/Atem-Audio-router/atem-audio-router" \
        "$HOME/Desktop/Atem-Audio-router/atem-audio-router" \
        "$HOME/Documents/Atem-Audio-router/atem-audio-router" \
        "$HOME/Documents/Claude/atemrouting/atem-audio-router" \
        "$HOME/Atem-Audio-router/atem-audio-router"; do
        if [ -d "$CHECK_DIR/src" ] && [ -f "$CHECK_DIR/package.json" ]; then
            SERVER_DIR="$CHECK_DIR"
            break
        fi
    done
fi

# Still not found — ask the user
if [ -z "$SERVER_DIR" ] || [ ! -d "$SERVER_DIR" ]; then
    CHOSEN=$(osascript -e '
        set chosenFolder to choose folder with prompt "Select the atem-audio-router folder (the one containing package.json):"
        return POSIX path of chosenFolder
    ' 2>/dev/null)

    if [ -z "$CHOSEN" ]; then
        exit 0
    fi

    # Remove trailing slash
    SERVER_DIR="${CHOSEN%/}"

    if [ ! -f "$SERVER_DIR/package.json" ]; then
        osascript -e 'display alert "Invalid Folder" message "That folder does not contain package.json. Please select the atem-audio-router folder." as critical buttons {"OK"}'
        exit 1
    fi
fi

# ── Prompt for ATEM IP ───────────────────────────
PROMPT_TEXT="Enter ATEM IP address:"
if [ -n "$ATEM_IP" ]; then
    PROMPT_TEXT="Enter ATEM IP address (last used: $ATEM_IP):"
fi

RESULT=$(osascript <<EOF
set defaultIP to "$ATEM_IP"

set ipDialog to display dialog "$PROMPT_TEXT" default answer defaultIP buttons {"No ATEM", "Connect"} default button "Connect" with title "ATEM Audio Router"
set atemIP to text returned of ipDialog
set chosenButton to button returned of ipDialog

if chosenButton is "No ATEM" then
    return "|false"
end if

try
    set splitDialog to display dialog "Split all stereo inputs to dual mono?" buttons {"No", "Yes"} default button "No" with title "ATEM Audio Router"
    if button returned of splitDialog is "Yes" then
        return atemIP & "|true"
    else
        return atemIP & "|false"
    end if
on error
    return atemIP & "|false"
end try
EOF
)

# User cancelled
if [ $? -ne 0 ]; then
    exit 0
fi

ATEM_IP=$(echo "$RESULT" | cut -d'|' -f1)
SPLIT_STEREO=$(echo "$RESULT" | cut -d'|' -f2)

# ── Save config ─────────────────────────────────
cat > "$CONFIG_FILE" << CONF
ATEM_IP="$ATEM_IP"
SPLIT_STEREO="$SPLIT_STEREO"
SERVER_DIR="$SERVER_DIR"
CONF

# ── Build the launch command ─────────────────────
ARGS=""
if [ -n "$ATEM_IP" ]; then
    ARGS="$ATEM_IP"
fi
if [ "$SPLIT_STEREO" = "true" ]; then
    ARGS="$ARGS --split-stereo"
fi

# ── Launch in Terminal ───────────────────────────
# Terminal.app has full disk access and its own PATH setup,
# avoiding App Translocation and sandbox issues entirely.
osascript <<EOF
tell application "Terminal"
    activate
    set newTab to do script "cd \"$SERVER_DIR\" && npm install --silent 2>/dev/null; echo ''; echo 'Starting ATEM Audio Router...'; echo 'Press Ctrl+C to stop.'; echo ''; node src/server.js $ARGS; echo ''; echo 'Server stopped. You can close this window.'"
    set custom title of front window to "ATEM Audio Router"
end tell
EOF

# ── Wait a moment then open the browser ──────────
sleep 2
open "http://localhost:4000"
