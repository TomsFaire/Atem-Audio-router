#!/bin/bash

# ATEM Audio Router — macOS .app launcher
# Starts the Node.js server and opens the web UI

# macOS .app bundles run with a minimal PATH — add common Node.js locations
export PATH="/usr/local/bin:/opt/homebrew/bin:/opt/local/bin:$HOME/.nvm/versions/node/$(ls -1 $HOME/.nvm/versions/node/ 2>/dev/null | tail -1)/bin:$PATH"

# Also source shell profile in case Node is managed by nvm/fnm/volta
for f in "$HOME/.zshrc" "$HOME/.bashrc" "$HOME/.bash_profile" "$HOME/.profile"; do
    if [ -f "$f" ]; then
        source "$f" 2>/dev/null
        break
    fi
done

# ── Resolve real path (bypasses macOS App Translocation) ──
# macOS moves downloaded/unzipped .apps to a random temp path before running.
# We need to find where the repo actually lives on disk.
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
APP_DIR="$(cd "$SCRIPT_DIR/../../.." && pwd)"

# Detect App Translocation (path contains AppTranslocation)
if [[ "$APP_DIR" == *"AppTranslocation"* ]]; then
    # Ask the user to locate the repo folder
    REAL_DIR=$(osascript -e 'set repoFolder to choose folder with prompt "ATEM Audio Router was launched from a translocated path.\n\nPlease select the Atem-Audio-router folder where you cloned the repo:"' 2>/dev/null | sed 's/alias //' | sed 's/:/\//g' | sed 's/^/\//' | sed 's/\/$//')

    if [ -z "$REAL_DIR" ] || [ ! -d "$REAL_DIR/atem-audio-router" ]; then
        # Try common locations automatically
        for CHECK_DIR in \
            "$HOME/Downloads/Atem-Audio-router" \
            "$HOME/Desktop/Atem-Audio-router" \
            "$HOME/Documents/Atem-Audio-router" \
            "$HOME/Atem-Audio-router"; do
            if [ -d "$CHECK_DIR/atem-audio-router" ]; then
                REAL_DIR="$CHECK_DIR"
                break
            fi
        done
    fi

    if [ -z "$REAL_DIR" ] || [ ! -d "$REAL_DIR/atem-audio-router" ]; then
        osascript -e 'display alert "Cannot Find Project" message "Could not locate the atem-audio-router folder.\n\nTip: Right-click the .app, choose Open, or move it out of the Downloads folder to avoid macOS App Translocation." as critical buttons {"OK"}'
        exit 1
    fi

    APP_DIR="$REAL_DIR"
fi

SERVER_DIR="$APP_DIR/atem-audio-router"
CONFIG_FILE="$HOME/.atem-router-config"
PORT=4000
LOG_FILE="$HOME/.atem-router.log"

# ── Check for Node.js ────────────────────────────
if ! command -v node &>/dev/null; then
    osascript -e 'display alert "Node.js Required" message "ATEM Audio Router requires Node.js to run.\n\nInstall it from https://nodejs.org" as critical buttons {"OK"}'
    exit 1
fi

# ── Install dependencies if needed ───────────────
if [ ! -d "$SERVER_DIR/node_modules" ]; then
    osascript -e 'display notification "Installing dependencies..." with title "ATEM Audio Router"'
    npm install --prefix "$SERVER_DIR" >> "$LOG_FILE" 2>&1
    if [ $? -ne 0 ]; then
        osascript -e 'display alert "Install Failed" message "Could not install dependencies. Check the log at:\n'"$LOG_FILE"'" as critical buttons {"OK"}'
        exit 1
    fi
fi

# ── Load or prompt for ATEM IP ───────────────────
ATEM_IP=""
SPLIT_STEREO=""

if [ -f "$CONFIG_FILE" ]; then
    source "$CONFIG_FILE"
fi

PROMPT_TEXT="Enter ATEM IP address:"
if [ -n "$ATEM_IP" ]; then
    PROMPT_TEXT="Enter ATEM IP address (last used: $ATEM_IP):"
fi

RESULT=$(osascript <<EOF
set defaultIP to "$ATEM_IP"
set splitDefault to false
if "$SPLIT_STEREO" is "true" then
    set splitDefault to true
end if

set ipDialog to display dialog "$PROMPT_TEXT" default answer defaultIP buttons {"No ATEM", "Connect"} default button "Connect" with title "ATEM Audio Router"
set atemIP to text returned of ipDialog
set chosenButton to button returned of ipDialog

if chosenButton is "No ATEM" then
    return "||false"
end if

try
    set splitDialog to display dialog "Split all stereo inputs to dual mono?" buttons {"No", "Yes"} default button "No" with title "ATEM Audio Router"
    if button returned of splitDialog is "Yes" then
        return atemIP & "|" & "true"
    else
        return atemIP & "|" & "false"
    end if
on error
    return atemIP & "|" & "false"
end try
EOF
)

# User cancelled the dialog
if [ $? -ne 0 ]; then
    exit 0
fi

ATEM_IP=$(echo "$RESULT" | cut -d'|' -f1)
SPLIT_STEREO=$(echo "$RESULT" | cut -d'|' -f2)

# Save config for next launch
cat > "$CONFIG_FILE" << CONF
ATEM_IP="$ATEM_IP"
SPLIT_STEREO="$SPLIT_STEREO"
CONF

# ── Build launch args ────────────────────────────
ARGS=""
if [ -n "$ATEM_IP" ]; then
    ARGS="$ATEM_IP"
fi
if [ "$SPLIT_STEREO" = "true" ]; then
    ARGS="$ARGS --split-stereo"
fi

# ── Start the server ─────────────────────────────
# Use absolute path to server.js instead of cd + relative path
# (cd can fail under App Translocation when the temp cwd is revoked)

echo "$(date): Starting ATEM Audio Router..." >> "$LOG_FILE"
echo "  Server dir: $SERVER_DIR" >> "$LOG_FILE"
echo "  ATEM IP: ${ATEM_IP:-none}" >> "$LOG_FILE"
echo "  Split Stereo: $SPLIT_STEREO" >> "$LOG_FILE"

node "$SERVER_DIR/src/server.js" $ARGS >> "$LOG_FILE" 2>&1 &
SERVER_PID=$!

# Wait a moment for the server to start
sleep 1

# Check if server is still running
if ! kill -0 $SERVER_PID 2>/dev/null; then
    osascript -e 'display alert "Server Failed" message "The ATEM Audio Router server failed to start. Check the log at:\n'"$LOG_FILE"'" as critical buttons {"OK"}'
    exit 1
fi

# ── Open the web UI ──────────────────────────────
open "http://localhost:$PORT"

# ── Show notification ────────────────────────────
osascript -e 'display notification "Server running on port '"$PORT"'" with title "ATEM Audio Router" subtitle "Web UI opened in browser"'

# ── Wait for server to exit ──────────────────────
# Keep the .app process alive so it shows in the dock
wait $SERVER_PID
